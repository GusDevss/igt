# ==============================================================
#  Integral Gym Tech – sitio estático (Hostinger / Apache)
# ==============================================================
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS y sin "www"
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Proteger configuración
RewriteRule ^config-correo\.php$ - [F,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Redirecciones de URLs antiguas de WordPress
RewriteRule ^mantenimiento/?$ /mantenimiento-de-equipo/ [R=301,L]
RewriteRule ^portfolio-category/([a-z0-9\-]+)/?$ /$1/ [R=301,L]
RewriteRule ^portfolio/([a-z0-9\-]+)/?$ / [R=301,L]
RewriteRule ^(feed|comments/feed|wp-json|xmlrpc\.php|wp-login\.php|wp-admin)(/.*)?$ / [R=301,L]
RewriteRule ^(tienda|shop|carrito|cart|checkout|finalizar-compra|mi-cuenta|my-account)(/.*)?$ / [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(page|post|product)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(wp-content|wp-includes|assets/uploads|assets/plugins|assets/theme)/.*$ - [G,L]

# Agregar "/" final a las páginas (ej. /cardio -> /cardio/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml font/ttf font/otf application/x-font-ttf
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/octet-stream .bcmap
</IfModule>

# Seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(ttf|otf|woff2?|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
